# Copia este ficheiro para ".env" e preenche com os valores do teu projeto Supabase
# (Project Settings > API Keys). O ficheiro .env NUNCA vai para o GitHub.
#
# Usa APENAS a chave publishable (sb_publishable_...) ou anon.
# NUNCA a chave secret / service_role.

SUPABASE_URL=https://o-teu-projeto.supabase.co
SUPABASE_KEY=sb_publishable_coloca_aqui_a_tua_chave
